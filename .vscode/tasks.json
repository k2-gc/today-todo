{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "npm: compile",
			"type": "shell",
			"command": "npm run compile",
			"problemMatcher": "$tsc",
			"group": {
				"kind": "build",
			},
		},
		{
			"label": "npm: build:webview",
			"type": "shell",
			"command": "npm run build:webview",
			"problemMatcher": [],
			"group": {
				"kind": "build",
			},
		},
		{
			"label": "build-all",
			"dependsOn": [
				"npm: compile",
				"npm: build:webview"
			],
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
