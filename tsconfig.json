{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"outDir": "out",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"moduleResolution": "node16"
	},
	"include": [
		"src/**/*",
		"core/**/*"
	],
	"exclude": [
		"node_modules",
		"webview-ui",
		"out"
	]
}
